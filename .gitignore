android/key.properties
*.jks
*.keystore

# Python caches from tool/ scripts
__pycache__/

# OS and editor files
.DS_Store
.idea/

# Local-only working notes, kept out of the repo.
docs/store-submission-checklist.md

# Build-time secrets (Mapbox token) for --dart-define-from-file.
dart_defines.json
